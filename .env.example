# ==============================================================================
# Private Ledger - Localhost Environment Configuration
# Ready to run out of the box with PostgreSQL and zero-config local storage
# ==============================================================================

# SERVER CONFIGURATION
PORT="3000"
APP_URL="http://localhost:3000"

# AUTHENTICATION & SECURITY
JWT_SECRET="private_ledger_dev_secret_key_2026"

# POSTGRESQL DATABASE CONFIGURATION (Localhost / Supabase / Cloud SQL)
# If PostgreSQL is running on port 5432, the application automatically connects.
# If PostgreSQL is not active, the application runs seamlessly in local mode.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expense_tracker"
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="expense_tracker"
